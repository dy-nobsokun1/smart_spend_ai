# Local demo defaults to SQLite. For MySQL, create the database first and set:
# DATABASE_URL=mysql+pymysql://smartspend:password@127.0.0.1:3306/smartspend?charset=utf8mb4
DATABASE_URL=sqlite:///./data/smartspend.db
# Sample records are inserted only when all application tables are empty.
DEMO_DATA=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
